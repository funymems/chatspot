# Copy to .env.local. Every variable is optional for local development.

# Hosted Postgres (Supabase → Connect → Transaction pooler, port 6543).
# When set it replaces the local PGlite database. Required on Vercel.
DATABASE_URL=
# Optional: Supabase CA certificate (PEM) to verify the TLS certificate.
# DATABASE_SSL_CA=

# Public contact email shown on /privacy and /data-deletion.
SUPPORT_EMAIL=

# Local only: where the embedded Postgres (PGlite) stores data. Default: .data/pglite
# PGLITE_DATA_DIR=.data/pglite

# AI provider: Google Gemini (server-side only, never exposed to the browser).
# Get a key at https://aistudio.google.com/apikey. Leave empty to run AI
# features in clearly labelled, deterministic demo mode.
GEMINI_API_KEY=
# Model for agents and the AI flow generator. Default: gemini-3.5-flash-lite
# ($0.30 in / $2.50 out per 1M tokens). Smarter but pricier: gemini-3.8-flash.
AI_MODEL=gemini-3.5-flash-lite

# Background jobs: the dev server pings /api/jobs/tick every second.
# On serverless set JOB_WORKER=off and call the route from a cron with
# "Authorization: Bearer $CRON_SECRET".
# JOB_WORKER=off
# CRON_SECRET=

# Structured log level: debug | info | warn | error
# LOG_LEVEL=info

# ─── Instagram (Instagram API with Instagram Login) ─────────────────────────
# Public base URL of this app, HTTPS in production (no trailing slash).
# Used to build the OAuth redirect and to show the webhook Callback URL.
APP_BASE_URL=http://localhost:3000
# Instagram app ID and secret: Meta App Dashboard → Instagram → API setup with
# Instagram login (these are NOT the Facebook Login for Business credentials).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional. Defaults to $APP_BASE_URL/api/integrations/instagram/callback.
# Must exactly match a "Valid OAuth Redirect URI" in the App Dashboard.
INSTAGRAM_REDIRECT_URI=
# Any long random string you choose; enter the same value as the "Verify Token"
# in Meta's webhook settings. This is NOT an access token.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Optional: Meta app secret (Settings → Basic). Also accepted for webhook
# signatures, in case Meta signs with it rather than the Instagram app secret.
META_APP_SECRET=
# 32 random bytes, base64. Encrypts stored access tokens (AES-256-GCM).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Graph API version for graph.instagram.com calls.
INSTAGRAM_GRAPH_VERSION=v25.0
